# Salin menjadi backend/.env lalu isi nilainya. JANGAN commit berkas .env.
# Referensi: docs/SDD.md Bagian 10–12.

# --- Umum ---
MODE=cloud                      # cloud | posko
ROLE=all                        # api | worker | all
HTTP_ADDR=:8080
PUBLIC_BASE_URL=                # contoh: https://api.we-ired.id (wajib untuk webhook WhatsApp)
LOG_LEVEL=info

# --- Basis data ---
DATABASE_URL=postgres://weired:weired@localhost:5432/weired?sslmode=disable

# --- Keamanan ---
JWT_SECRET=                     # string acak panjang
DATA_KEY=                       # 32 byte base64, untuk enkripsi AES-256-GCM kolom sensitif
ANNOUNCE_SIGNING_KEY=           # kunci privat Ed25519 (base64), hanya di cloud

# --- WhatsApp Cloud API (Meta) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=                  # untuk verifikasi tanda tangan webhook
WA_VERIFY_TOKEN=                # token verifikasi saat mendaftarkan webhook
WA_REMINDER_MINUTES=10,25

# --- Firebase Cloud Messaging ---
FCM_CREDENTIALS_FILE=           # path ke file service account (di luar repo)

# --- AI ---
AI_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Integrasi BMKG ---
BMKG_POLL_INTERVAL=5m

# --- Posko Lokal ---
POSKO_ID=                       # diisi saat mode=posko
CLOUD_SYNC_URL=                 # URL backend cloud untuk push/pull
